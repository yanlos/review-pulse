{
  "name": "review-pulse",
  "version": "0.1.0",
  "private": true,
  "description": "Review flow insights for public GitHub repositories",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.ts",
    "dev:ui": "vite --config ui/vite.config.ts",
    "build": "vite build --config ui/vite.config.ts",
    "start": "node --env-file-if-exists=.env src/server.ts",
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json && tsc -p ui/tsconfig.json"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.6.0",
    "@fastify/rate-limit": "11.2.2",
    "@fastify/static": "10.1.10",
    "better-sqlite3": "13.0.3",
    "fastify": "5.12.8",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "vite": "8.3.6"
  }
}
